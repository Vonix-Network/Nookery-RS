diff --git a/cmake/aurora_core.cmake b/cmake/aurora_core.cmake
index eb0222e..15c20ba 100644
--- a/cmake/aurora_core.cmake
+++ b/cmake/aurora_core.cmake
@@ -44,7 +44,14 @@ endif ()
 
 if (CMAKE_SYSTEM_NAME STREQUAL Windows)
     # stuff for fetching system info.
+    # MSVC spells Windows import libraries `foo.lib`; MinGW-w64 uses `foo`.
+  # comsuppw has no MinGW equivalent and is only needed by the MSVC-only
+  # COM smart-pointer support this file does not use.
+  if (MSVC)
     target_link_libraries(aurora_core PRIVATE wbemuuid.lib comsuppw.lib ntdll.lib DXGI.lib)
+  else ()
+    target_link_libraries(aurora_core PRIVATE wbemuuid ntdll dxgi)
+  endif ()
 elseif (APPLE)
     target_sources(aurora_core PRIVATE lib/system_info_mac.mm)
     target_link_libraries(aurora_core PRIVATE "-framework Foundation")
