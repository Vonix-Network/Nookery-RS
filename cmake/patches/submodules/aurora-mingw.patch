diff --git a/lib/thread.cpp b/lib/thread.cpp
index 348b0ec..02d8404 100644
--- a/lib/thread.cpp
+++ b/lib/thread.cpp
@@ -20,7 +20,7 @@
 #ifndef WIN32_LEAN_AND_MEAN
 #define WIN32_LEAN_AND_MEAN
 #endif
-#include <Windows.h>
+#include <windows.h>
 #elif defined(__APPLE__)
 #include <pthread.h>
 #endif
@@ -270,7 +270,15 @@ void set_thread_name(const std::string& name) noexcept {
   std::wstring wideName;
   wideName.resize(static_cast<size_t>(length));
   MultiByteToWideChar(CP_UTF8, 0, name.data(), static_cast<int>(name.size()), wideName.data(), length);
-  SetThreadDescription(GetCurrentThread(), wideName.c_str());
+  // MinGW-w64 13 does not declare SetThreadDescription (Windows 10 1607+), and
+  // it is diagnostics-only, so resolve it from kernel32 at runtime instead of
+  // requiring the SDK prototype. Absent on older Windows: naming is skipped.
+  using SetThreadDescriptionFn = HRESULT(WINAPI*)(HANDLE, PCWSTR);
+  static const auto set_thread_description = reinterpret_cast<SetThreadDescriptionFn>(
+      GetProcAddress(GetModuleHandleW(L"kernel32.dll"), "SetThreadDescription"));
+  if (set_thread_description != nullptr) {
+    set_thread_description(GetCurrentThread(), wideName.c_str());
+  }
 #elif defined(__APPLE__)
   const std::string truncated = name.substr(0, 63);
   pthread_setname_np(truncated.c_str());
